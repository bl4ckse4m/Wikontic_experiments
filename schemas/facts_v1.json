{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wikontic_facts_v1",
  "title": "Wikontic hyper-relational fact set v1",
  "type": "object",
  "required": ["triplets"],
  "properties": {
    "triplets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "relation", "object", "qualifiers"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "object": {"type": "string", "minLength": 1},
          "qualifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["relation", "object"],
              "properties": {
                "relation": {"type": "string", "minLength": 1},
                "object": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "subject_type": {"type": "string"},
          "object_type": {"type": "string"},
          "claim_ids": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "Service field: ids of internal claims this fact comes from (claimwise variant). Not part of the student target."
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Service field of the claimwise variant: atomic claims listed inside the same single response. Not part of the student target."
    }
  },
  "additionalProperties": false
}
